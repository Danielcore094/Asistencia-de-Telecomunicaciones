DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# ── Docente administrador inicial (opcional) ────────────────────
# Configura las tres variables para crearlo durante `prisma db seed`.
# Déjalas vacías para cargar únicamente el catálogo de materias.
DOCENTE_INICIAL_EMAIL=
DOCENTE_INICIAL_CONTRASENA=
DOCENTE_INICIAL_NOMBRE=

# ── Brevo Email API ──────────────────────────────────────────────
# Obtén tu API Key en: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=tu_api_key_aca
BREVO_SENDER_EMAIL=tu_email@ejemplo.com
BREVO_SENDER_NAME="Tu Nombre o Sistema"
WEEKLY_REPORT_RECIPIENT_EMAIL=correo_de_reporte@ejemplo.com
WEEKLY_REPORT_RECIPIENT_NAME="Administrador de Asistencia"

# ── Evolution API (WhatsApp) ────────────────────────────────────
EVOLUTION_API_URL=http://localhost:5000
EVOLUTION_API_KEY=tu_api_key_evolution
EVOLUTION_INSTANCE=nombre_instancia
WHATSAPP_SEND_DELAY_MS=10000
 
# JWT (firmado para tokens de sesión)
# Genera un secreto fuerte: `openssl rand -base64 32` o similar
JWT_SECRET=tu_secreto_jwt_aqui

# Orígenes autorizados a consumir la API, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Protección local contra intentos repetidos de inicio de sesión
MAXIMO_INTENTOS_INICIO_SESION=5
VENTANA_INTENTOS_INICIO_SESION_MS=900000

# Límite distribuido para producción con Redis REST compatible con Upstash
UPSTASH_REDIS_REST_URL=https://tu-instancia-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_redis

# Habilitar solo en una instancia dedicada de la aplicación
EJECUTAR_CRON=false
