# Base de datos local para Docker Compose
POSTGRES_USER=telecom
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=asistencia
POSTGRES_PORT=5432

# URL con la que los usuarios accederán al sistema desde la red institucional
PUBLIC_URL=http://IP_DEL_SERVIDOR:3000

# Puerto del frontend
FRONTEND_PORT=3000

# Etiqueta de las imágenes exportadas para el servidor
IMAGE_TAG=2026-09-03

# Genera un valor largo y aleatorio
JWT_SECRET=cambia_este_secreto_jwt

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=tu_clave_publica_turnstile
TURNSTILE_SECRET_KEY=tu_secreto_turnstile

# Opcional: Evolution API y notificaciones
EVOLUTION_PORT=5000
EVOLUTION_API_KEY=tu_clave_evolution
EVOLUTION_INSTANCE=nombre_instancia
BREVO_API_KEY=tu_api_key_brevo
BREVO_SENDER_EMAIL=tu_email@ejemplo.com
BREVO_SENDER_NAME=Sistema de Asistencia
WEEKLY_REPORT_RECIPIENT_EMAIL=correo@ejemplo.com
WEEKLY_REPORT_RECIPIENT_NAME=Administrador
